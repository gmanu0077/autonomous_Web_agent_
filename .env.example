# =============================================================================
# Web Agent Framework — environment template
# Copy to ".env" and fill in secrets. Never commit ".env".
#
# This repo reads OS environment variables in web_agent_framework/config.py.
# To load from a file automatically: export vars manually, use your shell's
# dotenv support, or: pip install python-dotenv and call load_dotenv() at startup.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — choose one provider ("gemini" or "ollama")
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Chat / generation model (provider-specific).
# gemini examples: gemini-flash-latest, gemini-1.5-flash, gemini-1.5-pro
# ollama examples: qwen3-coder:30b, llama3.2, mistral (run: ollama pull <name>)
LLM_MODEL=gemini-flash-latest

# Optional: override defaults for specific subsystems (defaults to LLM_MODEL).
CHAT_MODEL_NAME=
PLANNER_MODEL=

# Gemini API — required when LLM_PROVIDER=gemini
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alias; if set, used when GEMINI_API_KEY is empty
GOOGLE_API_KEY=

# Embeddings — used for code RAG (build_embeddings) and per-job Node RAG indexing
# gemini default: models/gemini-embedding-001
# ollama default: nomic-embed-text
EMBEDDING_MODEL=

# -----------------------------------------------------------------------------
# Paths — Chroma (code RAG) and job working directories
# -----------------------------------------------------------------------------
# Persistent Chroma directory for Pydoll/Selenium code snippets (populate with:
#   python -m web_agent_framework.build_embeddings
# On Windows you may use a drive path; on macOS/Linux use e.g. ./chroma_db_pydoll
DB_DIR=./chroma_db_pydoll
COLLECTION_NAME=pydoll_code

# Root folder for per-job artifacts: graph_chunks.json, html/, node_rag/, steps/
TEMP_ROOT=./temp_pydoll

# -----------------------------------------------------------------------------
# MCP browser — the CLI pipeline uses get_browser_adapter() → MCPBrowserAdapter
# -----------------------------------------------------------------------------
# Internal MCP server: pydoll (default) or selenium
MCP_BROWSER=pydoll

# Leave empty to spawn the bundled MCP server (Pydoll or Selenium per MCP_BROWSER).
# To use an external server instead, e.g.:
# MCP_SERVER_URL=stdio:npx -y @modelcontextprotocol/server-browser
MCP_SERVER_URL=

# -----------------------------------------------------------------------------
# Retrieval / context budgets
# -----------------------------------------------------------------------------
MAX_CONTEXT_CHARS=425
MAX_HTML_CONTEXT_CHARS=108000
TOP_K=5

# Legacy autonomous pipeline retry budget
MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Node RAG (per-job DOM embeddings under <job_dir>/node_rag/)
# -----------------------------------------------------------------------------
NODE_RAG_BACKEND=chroma
NODE_RAG_CHROMA_COLLECTION=dom_nodes

# -----------------------------------------------------------------------------
# HTML pickling (Phase 1 persistence under <job_dir>/html/)
# -----------------------------------------------------------------------------
HTML_CHUNK_SIZE=1024
HTML_CHUNK_OVERLAP=128
